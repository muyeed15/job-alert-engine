# Copy to .env and fill in your credentials. Never commit the real .env file.

# Gmail account that sends the alerts
GMAIL_USER=your.account@gmail.com
# 16-character Google App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Spaces are stripped automatically, so "abcd efgh ijkl mnop" is valid.
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Optional SMTP settings (defaults shown). Use SMTP_SECURITY=starttls with SMTP_PORT=587 if port 465 is blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
MAIL_FROM_NAME=Job Alert Service
SMTP_TIMEOUT=30

# Optional path & runtime overrides
POLL_INTERVAL_MINUTES=60
# CONFIG_PATH=/opt/job-alert-engine/config.json
# DB_PATH=/opt/job-alert-engine/data/jobs.db
LOG_LEVEL=INFO
